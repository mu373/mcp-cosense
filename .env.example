# Exact Cosense project URLs allowed through this server, separated by commas.
# Access is disabled when this is empty.
COSENSE_ALLOWED_PROJECTS=

# Used by `docker compose run --rm login`. Use an origin for a Personal Access
# Token or an exact project URL for a project Service Account.
COSENSE_LOGIN_TARGET=https://scrapbox.io

COSENSE_MCP_PORT=8798
COSENSE_CLI_TIMEOUT_SECONDS=120
COSENSE_CLI_MAX_OUTPUT_BYTES=4194304
COSENSE_CLI_CONCURRENCY=4
